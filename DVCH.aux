\newlabel{tab:realdata_diagnostics}{{I}{8}{Non-overlapping diagnostic numbers associated with Fig.~\ref {fig:dvch_realdata_diagnostics}. Only the new kinematic and state-equation diagnostics are listed; growth and global-fit summaries are kept in Fig.~\ref {fig:dvch_sigma8_global} and Table~\ref {tab:final_global_status}}{table.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Additional non-overlapping real-data best-fit diagnostics generated from the self-contained master cell. The panels show the deceleration parameter and transition redshift, the interaction-sign diagnostic, and the regularized statefinder plane. The repeated growth/RSD information from Fig.~\ref {fig:dvch_sigma8_global} is intentionally omitted here.}}{9}{figure.3}\protected@file@percent }
\newlabel{fig:dvch_realdata_diagnostics}{{3}{9}{Additional non-overlapping real-data best-fit diagnostics generated from the self-contained master cell. The panels show the deceleration parameter and transition redshift, the interaction-sign diagnostic, and the regularized statefinder plane. The repeated growth/RSD information from Fig.~\ref {fig:dvch_sigma8_global} is intentionally omitted here}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Parameter-space robustness scan over $0.05\le n\le 0.45$ and $10^{-6}\le \beta \le 10^{-1}$. A grid point is marked viable only if the background integration is finite, $E^2>0$, densities remain non-negative, the interaction kernel is finite and its sign history is recorded over $0\le z\le 5$, and a finite transition redshift $0<z_t<2$ is found. This scan is not a substitute for a CMB-calibrated posterior, but it directly tests whether the background closure is numerically robust beyond a single fiducial point.}}{9}{figure.4}\protected@file@percent }
\newlabel{fig:dvch_robustness_scan}{{4}{9}{Parameter-space robustness scan over $0.05\le n\le 0.45$ and $10^{-6}\le \beta \le 10^{-1}$. A grid point is marked viable only if the background integration is finite, $E^2>0$, densities remain non-negative, the interaction kernel is finite and its sign history is recorded over $0\le z\le 5$, and a finite transition redshift $0<z_t<2$ is found. This scan is not a substitute for a CMB-calibrated posterior, but it directly tests whether the background closure is numerically robust beyond a single fiducial point}{figure.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {II}{\ignorespaces Summary of the DVCH robustness scan. The scan is deliberately limited to background-level viability and interaction-sign consistency; full perturbative/CMB viability remains part of the validation checklist.}}{10}{table.2}\protected@file@percent }
\newlabel{tab:dvch_robustness_scan}{{II}{10}{Summary of the DVCH robustness scan. The scan is deliberately limited to background-level viability and interaction-sign consistency; full perturbative/CMB viability remains part of the validation checklist}{table.2}{}}
